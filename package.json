{
  "name": "@jw-rami/worktree-cleaner",
  "version": "0.2.0",
  "description": "Interactive Git worktree cleanup for multi-repository workspaces.",
  "private": false,
  "type": "module",
  "bin": {
    "worktree-cleaner": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JW-Rami/worktree-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/JW-Rami/worktree-cleaner/issues"
  },
  "homepage": "https://github.com/JW-Rami/worktree-cleaner",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "npm run build && node --test dist/test/cli.e2e.test.js",
    "check": "tsc --noEmit",
    "ci": "bash scripts/local-ci.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
